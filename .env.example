# Абсолютный URL бэкенда, без trailing slash и без секретов.
# VITE_* попадают в клиентский бандл — токены сюда класть нельзя.
#
# https обязателен. http разрешён только для localhost и 127.0.0.1
# при `npm run dev`.
#
#   cp .env.example .env.local
#
# После изменения перезапусти npm run dev.
# .env и .env.* в git не коммитятся, кроме этого файла.
VITE_API_URL=https://api.example.com
